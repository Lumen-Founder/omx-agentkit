{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omx.invalid/spec/schemas/mandate.v0.schema.json",
  "title": "Agent Trading Mandate v0",
  "description": "Policy an agent operator sets for an AI agent that trades on a perpetuals venue. Units: USD notional, basis points, milliseconds, tenths of a basis point for builder fees.",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": {"^x-": {}},
  "required": ["mandate_version", "mandate_id", "issued_at", "venue", "network", "account", "coins", "notional",
               "leverage", "daily_loss", "price_band", "data_freshness", "child_order", "kill_switch",
               "human_approval", "builder_fee", "order_expiry"],
  "properties": {
    "mandate_version": {"const": "atm/0"},
    "mandate_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,80}$"},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "operator": {
      "type": "object", "additionalProperties": false,
      "properties": {"name": {"type": "string", "maxLength": 120}, "id": {"type": "string", "maxLength": 120}}
    },
    "venue": {"const": "hyperliquid"},
    "network": {"enum": ["mainnet", "testnet"]},
    "account": {"$ref": "#/$defs/address"},
    "agents": {"type": "array", "items": {"type": "string", "maxLength": 80}, "uniqueItems": true},
    "coins": {
      "type": "object", "additionalProperties": false, "required": ["allowed"],
      "properties": {"allowed": {"type": "array", "minItems": 1, "uniqueItems": true,
                                  "items": {"type": "string", "pattern": "^[A-Za-z0-9]{1,20}$"}}}
    },
    "notional": {
      "type": "object", "additionalProperties": false,
      "required": ["default_per_coin_usd", "account_usd", "count_resting_orders"],
      "properties": {
        "per_coin_usd": {"type": "object", "additionalProperties": {"$ref": "#/$defs/usd"}},
        "default_per_coin_usd": {"$ref": "#/$defs/usd"},
        "account_usd": {"$ref": "#/$defs/usd"},
        "count_resting_orders": {"const": true, "description": "Exposure is worst case: position plus every same-side resting order filled plus the new order."}
      }
    },
    "leverage": {
      "type": "object", "additionalProperties": false, "required": ["max"],
      "properties": {"max": {"type": "number", "exclusiveMinimum": 0, "maximum": 50}}
    },
    "daily_loss": {
      "type": "object", "additionalProperties": false, "required": ["max_usd", "excludes_external_flows", "day_boundary"],
      "properties": {
        "max_usd": {"$ref": "#/$defs/usd"},
        "excludes_external_flows": {"const": true, "description": "Day P&L = equity - day start equity - deposits + withdrawals (and transfers)."},
        "day_boundary": {"const": "UTC"}
      }
    },
    "price_band": {
      "type": "object", "additionalProperties": false, "required": ["max_bps_vs_mid"],
      "properties": {"max_bps_vs_mid": {"type": "number", "exclusiveMinimum": 0, "maximum": 5000}}
    },
    "data_freshness": {
      "type": "object", "additionalProperties": false, "required": ["max_age_ms"],
      "properties": {"max_age_ms": {"type": "integer", "minimum": 1, "maximum": 600000}}
    },
    "child_order": {
      "type": "object", "additionalProperties": false, "required": ["max_notional_usd"],
      "properties": {"max_notional_usd": {"$ref": "#/$defs/usd"}}
    },
    "kill_switch": {
      "type": "object", "additionalProperties": false, "required": ["engaged", "clear_requires"],
      "properties": {
        "engaged": {"type": "boolean"},
        "clear_requires": {"const": "human", "description": "An agent may engage the kill switch, never clear it."}
      }
    },
    "human_approval": {
      "type": "object", "additionalProperties": false, "required": ["above_notional_usd"],
      "properties": {"above_notional_usd": {"$ref": "#/$defs/usd"}}
    },
    "builder_fee": {
      "type": "object", "additionalProperties": false, "required": ["accepted", "max_tenths_bps", "disclosure"],
      "properties": {
        "accepted": {"type": "boolean", "description": "false: no order carrying a builder fee may be built for this account."},
        "builder": {"$ref": "#/$defs/address"},
        "max_tenths_bps": {"type": "integer", "minimum": 0, "maximum": 100, "description": "Highest fee the operator accepts per order, 10 = 1 bps. The venue charges at most what the account's main wallet approved."},
        "disclosure": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    },
    "order_expiry": {
      "type": "object", "additionalProperties": false, "required": ["max_ms"],
      "properties": {"max_ms": {"type": "integer", "minimum": 1000, "maximum": 600000, "description": "expiresAfter of every signed action must be within this of the build time."}}
    }
  },
  "$defs": {
    "address": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
    "usd": {"type": "number", "minimum": 0}
  }
}
